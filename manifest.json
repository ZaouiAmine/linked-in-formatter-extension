{
  "manifest_version": 2,
  "name": "LinkedIn Post Formatter",
  "version": "1.0.0",
  "description": "Format LinkedIn posts with rich text formatting using Unicode symbols",
  "permissions": [
    "activeTab",
    "https://www.linkedin.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_icon": "icons/icon.svg"
  },
  "icons": {
    "128": "icons/icon.svg"
  }
}

