{
  "manifest_version": 3,
  "name": "LinkedIn Post Formatter",
  "version": "5.0.0",
  "description": "Select text on LinkedIn to format it with bold, italic, underline and more using Unicode symbols.",
  "permissions": [],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://linkedin.com/*",
    "https://*.linkedin.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://linkedin.com/*",
        "https://*.linkedin.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "LinkedIn Post Formatter"
  }
}
